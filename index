<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ShelfScout</title>
<meta name="theme-color" content="#3B5BDB">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=IBM+Plex+Mono:wght@500;600&display=swap">
<script src="https://cdn.jsdelivr.net/npm/@zxing/library@0.21.3/umd/index.min.js"></script>
<style>
  :root{
    --bg:#F4F5F7; --surface:#FFFFFF; --surface-2:#EDEFF3; --ink:#171A1F;
    --muted:#5C6470; --line:#E1E4E9; --accent:#3B5BDB; --accent-ink:#FFFFFF;
    --good:#15803D; --mid:#B45309; --low:#B91C1C;
    --shadow:0 1px 2px rgba(20,24,31,.06),0 6px 20px rgba(20,24,31,.06);
    --radius:14px;
    --ui:'Archivo',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
    --mono:'IBM Plex Mono',ui-monospace,SFMono-Regular,Menlo,monospace;
    --safe-t:env(safe-area-inset-top,0px); --safe-b:env(safe-area-inset-bottom,0px);
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#0F1216; --surface:#181C22; --surface-2:#20252D; --ink:#EAECEF;
      --muted:#9AA3AF; --line:#2A2F37; --accent:#7C93FF; --accent-ink:#0F1216;
      --good:#4ADE80; --mid:#FBBF24; --low:#F87171;
      --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 24px rgba(0,0,0,.35);
    }
  }
  :root[data-theme="dark"]{
    --bg:#0F1216; --surface:#181C22; --surface-2:#20252D; --ink:#EAECEF;
    --muted:#9AA3AF; --line:#2A2F37; --accent:#7C93FF; --accent-ink:#0F1216;
    --good:#4ADE80; --mid:#FBBF24; --low:#F87171;
    --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 24px rgba(0,0,0,.35);
  }
  *{box-sizing:border-box}
  html,body{background:var(--bg);margin:0}
  body{font-family:var(--ui);color:var(--ink);line-height:1.45;-webkit-text-size-adjust:100%;
       padding-top:var(--safe-t);padding-bottom:var(--safe-b)}
  img{max-width:100%}
  [hidden]{display:none!important}
  .wrap{max-width:560px;margin:0 auto;padding:0 16px 40px}

  header.bar{
    position:sticky;top:var(--safe-t);z-index:20;
    background:color-mix(in srgb,var(--bg) 88%,transparent);
    backdrop-filter:saturate(1.4) blur(10px);
    border-bottom:1px solid var(--line);
    margin:0 -16px 16px;padding:12px 16px;
    display:flex;align-items:center;gap:10px}
  .logo{display:flex;align-items:center;gap:9px;font-weight:800;letter-spacing:-.02em;font-size:19px}
  .logo .mark{width:26px;height:26px;border-radius:7px;flex:0 0 auto;
    background:linear-gradient(135deg,var(--accent),color-mix(in srgb,var(--accent) 55%,#000));
    position:relative;box-shadow:var(--shadow)}
  .logo .mark::before,.logo .mark::after{content:"";position:absolute;top:6px;bottom:6px;width:2px;background:var(--accent-ink);border-radius:2px}
  .logo .mark::before{left:8px;box-shadow:3px 0 0 var(--accent-ink),7px 0 0 var(--accent-ink)}
  .logo .mark::after{right:7px}
  .spacer{flex:1}
  .iconbtn{appearance:none;border:1px solid var(--line);background:var(--surface);color:var(--ink);
    width:38px;height:38px;border-radius:10px;font-size:16px;cursor:pointer;display:grid;place-items:center}
  .iconbtn:active{transform:scale(.95)}

  .tagline{color:var(--muted);font-size:13px;margin:-4px 0 16px}
  .tagline b{color:var(--ink);font-weight:600}

  .seg{display:grid;grid-template-columns:1fr 1fr;gap:4px;background:var(--surface-2);border:1px solid var(--line);border-radius:12px;padding:4px;margin-bottom:16px}
  .seg button{appearance:none;border:0;background:transparent;color:var(--muted);font-family:var(--ui);
    font-weight:600;font-size:14px;padding:10px 8px;border-radius:9px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:7px}
  .seg button[aria-pressed="true"]{background:var(--surface);color:var(--ink);box-shadow:var(--shadow)}
  .seg .em{font-size:15px}

  .scan-cta{appearance:none;width:100%;border:0;cursor:pointer;font-family:var(--ui);font-weight:700;font-size:16px;
    color:var(--accent-ink);background:var(--accent);padding:15px;border-radius:var(--radius);
    display:flex;align-items:center;justify-content:center;gap:10px;box-shadow:var(--shadow)}
  .scan-cta:active{transform:translateY(1px)}
  .scan-cta.stop{background:var(--low)}

  #camwrap{margin-top:12px;border-radius:var(--radius);overflow:hidden;border:1px solid var(--line);background:#000;position:relative;aspect-ratio:3/4;max-height:64vh}
  #cam{width:100%;height:100%;object-fit:cover;display:block}
  #shot{width:100%;max-height:260px;object-fit:contain;background:#000;display:block}
  .reticle{position:absolute;inset:34% 8%;border:2px solid rgba(255,255,255,.92);border-radius:12px;box-shadow:0 0 0 100vmax rgba(0,0,0,.30);pointer-events:none}
  .reticle .laser{position:absolute;left:6px;right:6px;top:50%;height:2px;background:var(--low);box-shadow:0 0 10px var(--low);animation:scan 1.7s ease-in-out infinite}
  @keyframes scan{0%,100%{transform:translateY(-38px)}50%{transform:translateY(38px)}}
  @media (prefers-reduced-motion:reduce){.reticle .laser{animation:none}}
  .camnote{position:absolute;left:10px;right:10px;bottom:12px;font-size:12px;color:#fff;text-align:center;text-shadow:0 1px 3px rgba(0,0,0,.85)}
  .torch{position:absolute;top:10px;right:10px;appearance:none;border:0;border-radius:999px;
    width:42px;height:42px;font-size:18px;background:rgba(0,0,0,.5);color:#fff;cursor:pointer;backdrop-filter:blur(4px)}
  .torch[aria-pressed="true"]{background:var(--mid);color:#111}

  .row2{display:flex;gap:8px;margin-top:10px}
  .row2 .btn{flex:1}
  .manual{display:flex;gap:8px;margin-top:10px}
  .manual input{flex:1;min-width:0;font-family:var(--mono);font-size:15px;letter-spacing:.02em;
    padding:12px 13px;border:1px solid var(--line);border-radius:11px;background:var(--surface);color:var(--ink)}
  .manual input::placeholder{color:var(--muted);font-family:var(--ui)}
  .btn{appearance:none;border:1px solid var(--line);background:var(--surface);color:var(--ink);
    font-family:var(--ui);font-weight:600;font-size:14px;padding:12px 15px;border-radius:11px;cursor:pointer;white-space:nowrap;display:flex;align-items:center;justify-content:center;gap:7px}
  .btn:active{transform:translateY(1px)}
  .btn.primary{background:var(--accent);color:var(--accent-ink);border-color:transparent}

  input:focus-visible,button:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

  .status{margin-top:12px;padding:11px 13px;border-radius:11px;font-size:13px;line-height:1.4;border:1px solid var(--line)}
  .status.warn{background:color-mix(in srgb,var(--mid) 14%,var(--surface));border-color:color-mix(in srgb,var(--mid) 45%,var(--line));color:var(--ink)}
  .status.good{background:color-mix(in srgb,var(--good) 14%,var(--surface));border-color:color-mix(in srgb,var(--good) 45%,var(--line));color:var(--ink)}
  .status.info{background:var(--surface-2)}

  .card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:16px;margin-top:18px}
  .card .top{display:flex;align-items:center;gap:10px;margin-bottom:4px}
  .chip{font-size:11px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;padding:4px 9px;border-radius:999px;border:1px solid var(--line);color:var(--muted)}
  .chip.book{color:var(--accent);border-color:color-mix(in srgb,var(--accent) 40%,var(--line))}
  .chip.disc{color:var(--mid);border-color:color-mix(in srgb,var(--mid) 40%,var(--line))}
  .chip.example{color:var(--muted);background:var(--surface-2)}
  .code{font-family:var(--mono);font-size:13px;color:var(--muted)}
  .card h2{font-size:15px;font-weight:700;margin:8px 0 2px}
  .lbl{font-size:12px;font-weight:600;letter-spacing:.03em;text-transform:uppercase;color:var(--muted);margin:14px 0 6px}
  .searchrow{display:flex;gap:8px}
  .searchrow input{flex:1;min-width:0;font-family:var(--ui);font-size:15px;padding:12px 13px;border:1px solid var(--line);border-radius:11px;background:var(--surface);color:var(--ink)}
  .quick{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
  .quick button{appearance:none;border:1px dashed var(--line);background:transparent;color:var(--muted);font-family:var(--mono);font-size:12px;padding:5px 9px;border-radius:999px;cursor:pointer}
  .actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px}
  .actions a,.actions button{appearance:none;text-decoration:none;text-align:center;font-family:var(--ui);font-weight:700;font-size:14px;
    padding:13px 10px;border-radius:12px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:7px;border:1px solid var(--line)}
  .a-sold{background:var(--good);color:#fff;border-color:transparent}
  .a-active{background:var(--surface-2);color:var(--ink)}
  .a-add{grid-column:1 / -1;background:transparent;color:var(--accent);border:1px solid color-mix(in srgb,var(--accent) 45%,var(--line))}

  .haul{margin-top:26px}
  .haul .head{display:flex;align-items:baseline;gap:8px;margin-bottom:10px}
  .haul .head h3{font-size:15px;font-weight:700;margin:0}
  .haul .count{font-family:var(--mono);font-size:12px;color:var(--muted)}
  .haul .clear{margin-left:auto;font-size:12px;color:var(--muted);background:none;border:0;cursor:pointer;text-decoration:underline}
  .empty{border:1px dashed var(--line);border-radius:var(--radius);padding:20px 16px;text-align:center;color:var(--muted);font-size:13px}
  ul.list{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px}
  ul.list li{display:flex;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:10px 12px}
  li .dot{width:8px;height:8px;border-radius:50%;flex:0 0 auto}
  li .dot.book{background:var(--accent)}li .dot.disc{background:var(--mid)}
  li .meta{flex:1;min-width:0}
  li .meta .t{font-weight:600;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  li .meta .c{font-family:var(--mono);font-size:11px;color:var(--muted)}
  li a.go{text-decoration:none;font-weight:700;font-size:13px;color:var(--good);white-space:nowrap}
  li button.del{background:none;border:0;color:var(--muted);font-size:18px;cursor:pointer;padding:2px 4px;line-height:1}

  .foot{margin-top:26px;font-size:12px;color:var(--muted);border-top:1px solid var(--line);padding-top:14px}
  .foot b{color:var(--ink);font-weight:600}
</style>
</head>
<body>
<div class="wrap">
  <header class="bar">
    <span class="logo"><span class="mark" aria-hidden="true"></span>ShelfScout</span>
    <span class="spacer"></span>
    <button class="iconbtn" id="themeBtn" title="Toggle theme" aria-label="Toggle theme">◐</button>
  </header>

  <p class="tagline"><b>Point, lock on, price it.</b> Live-scan a barcode and jump straight to matching <b>eBay.com.au sold listings</b> — where you're already signed in.</p>

  <div class="seg" role="group" aria-label="Item type">
    <button id="mBook" aria-pressed="true"><span class="em">📚</span> Books</button>
    <button id="mDisc" aria-pressed="false"><span class="em">📀</span> DVD &amp; Blu-ray</button>
  </div>

  <button class="scan-cta" id="scanBtn"><span aria-hidden="true">📷</span> <span id="scanLbl">Start scanning</span></button>

  <div id="camwrap" hidden>
    <video id="cam" playsinline muted autoplay></video>
    <div class="reticle"><div class="laser"></div></div>
    <button class="torch" id="torchBtn" aria-pressed="false" aria-label="Toggle torch" hidden>🔦</button>
    <div class="camnote" id="camnote">Fill the box with the barcode</div>
  </div>

  <img id="shot" alt="Captured barcode photo" hidden>

  <div class="row2">
    <button class="btn" id="photoBtn">📸 Snap a photo instead</button>
  </div>
  <input id="capture" type="file" accept="image/*" capture="environment" hidden>

  <div class="manual">
    <input id="manualInput" inputmode="numeric" autocomplete="off" placeholder="…or type an ISBN / barcode number">
    <button class="btn primary" id="manualGo">Look up</button>
  </div>

  <div id="status" class="status" hidden></div>

  <section class="card" id="result">
    <div class="top">
      <span class="chip book" id="rChip">Book</span>
      <span class="chip example" id="rExample">Example</span>
      <span class="spacer"></span>
      <span class="code" id="rCode">9 780747 532699</span>
    </div>
    <h2 id="rTitle">Here's how a scan looks</h2>

    <div class="lbl">eBay search terms <span style="text-transform:none;font-weight:500;color:var(--muted)">(edit before searching)</span></div>
    <div class="searchrow"><input id="terms" value="9780747532699"></div>
    <div class="quick" id="quick"></div>

    <div class="actions">
      <a class="a-sold" id="btnSold" target="_blank" rel="noopener">💲 AU sold</a>
      <a class="a-active" id="btnActive" target="_blank" rel="noopener">🔎 AU active</a>
      <button class="a-add" id="btnAdd">＋ Add to haul</button>
    </div>
  </section>

  <section class="haul">
    <div class="head">
      <h3>Today's haul</h3><span class="count" id="haulCount">0 items</span>
      <button class="clear" id="haulClear" hidden>Clear</button>
    </div>
    <div class="empty" id="haulEmpty">Nothing scanned yet. Items you add show up here so you can tally a shelf and re-check prices.</div>
    <ul class="list" id="haulList"></ul>
  </section>

  <p class="foot">
    <b>Pricing:</b> books and discs have no clean price API, so ShelfScout hands you to real <b>eBay.com.au sold listings</b> — the honest read on what things fetch here. For discs, the barcode rarely appears in listings, so swap the number for the <b>title on the case</b> before searching.
  </p>
</div>

<script>
(function(){
  "use strict";
  var Z = window.ZXing || null;

  // ---------- theme ----------
  var root=document.documentElement, tBtn=document.getElementById('themeBtn');
  function sysDark(){ return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches; }
  try{ var th=localStorage.getItem('ss_theme'); if(th) root.setAttribute('data-theme',th); }catch(e){}
  tBtn.addEventListener('click',function(){
    var cur=root.getAttribute('data-theme')||(sysDark()?'dark':'light');
    var next=cur==='dark'?'light':'dark';
    root.setAttribute('data-theme',next);
    try{ localStorage.setItem('ss_theme',next); }catch(e){}
  });

  // ---------- status ----------
  var statusEl=document.getElementById('status');
  function setStatus(msg,kind){
    if(!msg){ statusEl.hidden=true; statusEl.innerHTML=''; return; }
    statusEl.className='status '+(kind||'info'); statusEl.innerHTML=msg; statusEl.hidden=false;
  }

  // ---------- state ----------
  var mode='book', CAT={book:'267',disc:'617'}, isExample=true, currentCode=null;
  var mBook=document.getElementById('mBook'), mDisc=document.getElementById('mDisc');
  var rChip=document.getElementById('rChip'), rExample=document.getElementById('rExample'),
      rCode=document.getElementById('rCode'), rTitle=document.getElementById('rTitle'),
      terms=document.getElementById('terms'), quick=document.getElementById('quick'),
      btnSold=document.getElementById('btnSold'), btnActive=document.getElementById('btnActive'),
      btnAdd=document.getElementById('btnAdd');

  function setMode(m){
    mode=m; mBook.setAttribute('aria-pressed',m==='book'); mDisc.setAttribute('aria-pressed',m==='disc');
    if(!isExample && currentCode) buildLinks();
  }
  mBook.addEventListener('click',function(){ setMode('book'); });
  mDisc.addEventListener('click',function(){ setMode('disc'); });

  // ---------- eBay links ----------
  function ebayUrl(q,sold){
    var u='https://www.ebay.com.au/sch/i.html?_nkw='+encodeURIComponent(q||'')+'&_sacat='+CAT[mode];
    if(sold) u+='&LH_Sold=1&LH_Complete=1';
    return u;
  }
  function buildLinks(){
    var q=terms.value.trim()||currentCode||'';
    btnSold.href=ebayUrl(q,true); btnActive.href=ebayUrl(q,false);
  }
  terms.addEventListener('input',buildLinks);

  function isbnPrefix(c){ return /^97[89]/.test(c); }
  function addQuick(label,val,replace){
    var b=document.createElement('button'); b.textContent=label;
    b.addEventListener('click',function(){
      terms.value = replace ? val : (terms.value.trim()+' '+val).trim();
      buildLinks(); terms.focus();
    });
    quick.appendChild(b);
  }
  function showItem(code){
    isExample=false; currentCode=code; rExample.hidden=true;
    if(isbnPrefix(code)) setMode('book');
    rChip.textContent=mode==='book'?'Book':'DVD / Blu-ray';
    rChip.className='chip '+(mode==='book'?'book':'disc');
    rCode.textContent=code;
    rTitle.textContent=mode==='book'?'ISBN scanned':'Barcode scanned';
    if(mode==='book'){ terms.value=code; }
    else { terms.value=''; terms.setAttribute('placeholder','Type the title on the case (e.g. Alien Blu-ray)'); }
    quick.innerHTML='';
    addQuick('Use barcode',code,true);
    if(mode==='book'){ addQuick('+ book',code+' book',true); }
    else { addQuick('+ Blu-ray','Blu-ray',false); addQuick('+ DVD','DVD',false); }
    buildLinks();
    beep(); vibrate();
    setStatus('Locked on: <b>'+code+'</b>. Edit the terms if needed, then tap <b>AU sold</b>.','good');
    document.getElementById('result').scrollIntoView({behavior:'smooth',block:'center'});
  }

  // ---------- feedback ----------
  function vibrate(){ try{ if(navigator.vibrate) navigator.vibrate(45); }catch(e){} }
  var actx=null;
  function beep(){
    try{
      actx=actx||new (window.AudioContext||window.webkitAudioContext)();
      var o=actx.createOscillator(),g=actx.createGain();
      o.type='sine'; o.frequency.value=880; o.connect(g); g.connect(actx.destination);
      g.gain.setValueAtTime(.001,actx.currentTime);
      g.gain.exponentialRampToValueAtTime(.25,actx.currentTime+.01);
      g.gain.exponentialRampToValueAtTime(.001,actx.currentTime+.16);
      o.start(); o.stop(actx.currentTime+.17);
    }catch(e){}
  }

  // ---------- manual ----------
  var manualInput=document.getElementById('manualInput'), manualGo=document.getElementById('manualGo');
  function doManual(){
    var v=(manualInput.value||'').replace(/[^0-9Xx]/g,'').trim();
    if(v.length>=8){ showItem(v); manualInput.value=''; } else { manualInput.focus(); }
  }
  manualGo.addEventListener('click',doManual);
  manualInput.addEventListener('keydown',function(e){ if(e.key==='Enter') doManual(); });

  // ---------- shared decode hints ----------
  var FORMATS=['ean_13','upc_a','ean_8','upc_e','code_128'];
  function zxHints(){
    var h=new Map();
    try{
      h.set(Z.DecodeHintType.POSSIBLE_FORMATS,[Z.BarcodeFormat.EAN_13,Z.BarcodeFormat.UPC_A,Z.BarcodeFormat.EAN_8,Z.BarcodeFormat.UPC_E,Z.BarcodeFormat.CODE_128]);
      h.set(Z.DecodeHintType.TRY_HARDER,true);
    }catch(e){}
    return h;
  }

  // ---------- live scan ----------
  var scanBtn=document.getElementById('scanBtn'), scanLbl=document.getElementById('scanLbl'),
      camwrap=document.getElementById('camwrap'), cam=document.getElementById('cam'),
      torchBtn=document.getElementById('torchBtn'), camnote=document.getElementById('camnote');
  var scanning=false, rafId=null, zxReader=null, detector=null, track=null, lastCode=null, lastAt=0, torchOn=false;

  function onLiveCode(code){
    var now=Date.now();
    if(code===lastCode && now-lastAt<2500) return;
    lastCode=code; lastAt=now;
    showItem(code);
  }

  async function startScan(){
    if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
      setStatus('This browser can’t open a live camera. Use <b>Snap a photo</b> or type the number.','warn'); return;
    }
    setStatus('Starting camera…','info');
    var stream;
    try{
      stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:'environment'}},audio:false});
    }catch(e){
      setStatus('Camera blocked ('+(e&&e.name||'error')+'). Tap the padlock in the address bar → allow Camera, then reload. Or use <b>Snap a photo</b> / type the number.','warn');
      return;
    }
    cam.srcObject=stream; try{ await cam.play(); }catch(e){}
    track=stream.getVideoTracks()[0];
    scanning=true; camwrap.hidden=false;
    document.getElementById('shot').hidden=true;
    scanBtn.classList.add('stop'); scanLbl.textContent='Stop scanning';
    setStatus('');
    setupTorch();

    var useNative=false;
    if('BarcodeDetector' in window){
      try{
        var supported=await window.BarcodeDetector.getSupportedFormats();
        var fmts=FORMATS.filter(function(f){ return supported.indexOf(f)>-1; });
        if(fmts.length){ detector=new window.BarcodeDetector({formats:fmts}); useNative=true; }
      }catch(e){ useNative=false; }
    }
    if(useNative){ camnote.textContent='Fill the box with the barcode'; nativeLoop(); }
    else if(Z){ camnote.textContent='Fill the box with the barcode'; zxingLoop(stream); }
    else { setStatus('Scanner engine unavailable — use Snap a photo or type the number.','warn'); }
  }

  async function nativeLoop(){
    if(!scanning) return;
    try{
      var codes=await detector.detect(cam);
      if(codes && codes.length){ onLiveCode(codes[0].rawValue); }
    }catch(e){}
    rafId=requestAnimationFrame(nativeLoop);
  }

  function zxingLoop(stream){
    try{
      zxReader=new Z.BrowserMultiFormatReader(zxHints(),350);
      zxReader.decodeFromStream(stream, cam, function(result,err){
        if(result && scanning) onLiveCode(result.getText());
      }).catch(function(){
        // older API fallback
        zxReader.decodeFromConstraints({video:{facingMode:{ideal:'environment'}}},cam,function(result){
          if(result && scanning) onLiveCode(result.getText());
        });
      });
    }catch(e){
      setStatus('Live decoder failed to start — use Snap a photo or type the number.','warn');
    }
  }

  function setupTorch(){
    torchOn=false; torchBtn.setAttribute('aria-pressed','false');
    try{
      var caps=track.getCapabilities?track.getCapabilities():{};
      if(caps && caps.torch){ torchBtn.hidden=false; }
      else { torchBtn.hidden=true; }
    }catch(e){ torchBtn.hidden=true; }
  }
  torchBtn.addEventListener('click',async function(){
    if(!track) return;
    torchOn=!torchOn;
    try{ await track.applyConstraints({advanced:[{torch:torchOn}]}); torchBtn.setAttribute('aria-pressed',torchOn); }
    catch(e){ torchOn=false; torchBtn.setAttribute('aria-pressed','false'); }
  });

  function stopScan(){
    scanning=false;
    if(rafId) cancelAnimationFrame(rafId);
    try{ if(zxReader) zxReader.reset(); }catch(e){}
    zxReader=null;
    try{ if(cam.srcObject){ cam.srcObject.getTracks().forEach(function(t){ t.stop(); }); } }catch(e){}
    cam.srcObject=null; track=null;
    camwrap.hidden=true; torchBtn.hidden=true;
    scanBtn.classList.remove('stop'); scanLbl.textContent='Start scanning';
  }
  scanBtn.addEventListener('click',function(){ scanning?stopScan():startScan(); });

  // ---------- photo fallback ----------
  var photoBtn=document.getElementById('photoBtn'), captureInput=document.getElementById('capture'), shot=document.getElementById('shot');
  photoBtn.addEventListener('click',function(){ captureInput.click(); });
  captureInput.addEventListener('change',function(){
    var f=captureInput.files && captureInput.files[0]; captureInput.value='';
    if(!f) return;
    if(!Z){ setStatus('Scanner didn’t load — type the number below.','warn'); return; }
    var url=URL.createObjectURL(f);
    shot.src=url; shot.hidden=false; camwrap.hidden=true;
    setStatus('Reading barcode…','info');
    var r;
    try{ r=new Z.BrowserMultiFormatReader(zxHints()); }catch(e){ r=new Z.BrowserMultiFormatReader(); }
    r.decodeFromImageUrl(url).then(function(result){
      setStatus(''); showItem(result.getText()); URL.revokeObjectURL(url);
    }).catch(function(){
      setStatus('Couldn’t read that photo. Live scanning is far more reliable — tap <b>Start scanning</b> — or type the number below.','warn');
      URL.revokeObjectURL(url);
    });
  });

  // ---------- haul ----------
  var haul=[]; try{ haul=JSON.parse(localStorage.getItem('ss_haul')||'[]')||[]; }catch(e){ haul=[]; }
  var haulList=document.getElementById('haulList'), haulEmpty=document.getElementById('haulEmpty'),
      haulCount=document.getElementById('haulCount'), haulClear=document.getElementById('haulClear');
  function saveHaul(){ try{ localStorage.setItem('ss_haul',JSON.stringify(haul)); }catch(e){} }
  function renderHaul(){
    haulList.innerHTML='';
    haulCount.textContent=haul.length+(haul.length===1?' item':' items');
    haulEmpty.hidden=haul.length>0; haulClear.hidden=haul.length===0;
    haul.forEach(function(it,i){
      var li=document.createElement('li');
      var dot=document.createElement('span'); dot.className='dot '+it.mode; li.appendChild(dot);
      var meta=document.createElement('div'); meta.className='meta';
      var t=document.createElement('div'); t.className='t'; t.textContent=it.terms||it.code;
      var c=document.createElement('div'); c.className='c'; c.textContent=(it.mode==='book'?'Book · ':'Disc · ')+it.code;
      meta.appendChild(t); meta.appendChild(c); li.appendChild(meta);
      var go=document.createElement('a'); go.className='go'; go.textContent='Sold ›'; go.target='_blank'; go.rel='noopener';
      go.href='https://www.ebay.com.au/sch/i.html?_nkw='+encodeURIComponent(it.terms||it.code)+'&_sacat='+(CAT[it.mode]||'')+'&LH_Sold=1&LH_Complete=1';
      li.appendChild(go);
      var del=document.createElement('button'); del.className='del'; del.setAttribute('aria-label','Remove'); del.textContent='×';
      del.addEventListener('click',function(){ haul.splice(i,1); saveHaul(); renderHaul(); });
      li.appendChild(del); haulList.appendChild(li);
    });
  }
  btnAdd.addEventListener('click',function(){
    if(isExample||!currentCode) return;
    haul.unshift({code:currentCode,terms:terms.value.trim()||currentCode,mode:mode,ts:Date.now()});
    saveHaul(); renderHaul();
    btnAdd.textContent='✓ Added'; setTimeout(function(){ btnAdd.textContent='＋ Add to haul'; },1100);
  });
  haulClear.addEventListener('click',function(){ if(confirm('Clear today’s haul?')){ haul=[]; saveHaul(); renderHaul(); } });

  renderHaul(); buildLinks();
})();
</script>
</body>
</html>
